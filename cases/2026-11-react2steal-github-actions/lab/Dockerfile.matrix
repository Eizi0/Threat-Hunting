# Matrice de versions : docker build -f Dockerfile.matrix --build-arg NEXT_VER=x --build-arg REACT_VER=y -t r2s-lab:x .
FROM node:22-bookworm-slim
ARG NEXT_VER
ARG REACT_VER
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl iproute2 python3 procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY app/ ./
RUN npm pkg set dependencies.next=$NEXT_VER dependencies.react=$REACT_VER dependencies.react-dom=$REACT_VER \
 && npm install --no-audit --no-fund && npx next telemetry disable && npm run build
COPY nginx.conf /etc/nginx/nginx.conf
